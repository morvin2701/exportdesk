{
  "name": "exportdesk",
  "version": "1.0.0",
  "description": "ExportDesk - export invoice generator. Frontend in public/ (Vercel), backend in server/ (your server).",
  "private": true,
  "scripts": {
    "postinstall": "cd server && npm install --omit=dev --no-audit --no-fund",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:exe": "cd server && npx --yes @yao-pkg/pkg index.js -t node22.23.2-win-x64 -o ../dist/ExportDesk-server --no-bytecode --public --public-packages \"*\""
  },
  "engines": {
    "node": ">=18"
  }
}
