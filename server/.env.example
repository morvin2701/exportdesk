# ---- ExportDesk backend configuration (copy to server/.env) ----

# Port the API listens on, and bind address (127.0.0.1 = only a reverse proxy such as Caddy on this PC can reach Node)
PORT=4000
HOST=0.0.0.0

# Allowed browser origins when the frontend is hosted elsewhere (comma separated). Leave empty when the
# Node server serves the frontend itself or when Vercel rewrites proxy /api to this server.
CORS_ORIGIN=

# Cookie settings. Behind HTTPS set COOKIE_SECURE=1. For a frontend on a different domain (CORS mode)
# also set COOKIE_SAMESITE=none (requires HTTPS).
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Optional: configure the SQL Server connection here instead of the in-app wizard.
# DB_SERVER=WIN-PC\SQLEXPRESS
# DB_PORT=
# DB_AUTH=sql            # sql | windows
# DB_DOMAIN=
# DB_USER=sa
# DB_PASSWORD=secret
# DB_DATABASE=ExportDesk
# DB_ENCRYPT=true
