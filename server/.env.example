# ---- ExportDesk backend configuration (copy to server/.env) ----

# Port the API listens on, and bind address (127.0.0.1 = only a reverse proxy such as Caddy on this machine can reach Node)
PORT=4000
HOST=0.0.0.0

# Allowed browser origins when the frontend is hosted elsewhere WITHOUT Vercel rewrites (comma separated).
# Leave empty when Vercel rewrites proxy /api to this server (recommended) or when Node serves the frontend itself.
CORS_ORIGIN=
# Cookie flags. Behind HTTPS set COOKIE_SECURE=1. For a frontend on a different domain (CORS mode) also COOKIE_SAMESITE=none.
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Key used to sign sessions and to encrypt client SQL passwords in the registry. Any long random string.
# If empty, one is generated into server/config/secret.json on first start.
SECRET_KEY=

# =====================================================================
#  MULTI-CLIENT MODE (your server): registry database with the table `exportdesklink`
#  Set REGISTRY_SERVER to enable. Each client company gets a row with THEIR SQL Server address.
# =====================================================================
REGISTRY_SERVER=.\SQLEXPRESS
REGISTRY_PORT=
REGISTRY_AUTH=sql              # sql | windows
REGISTRY_DOMAIN=
REGISTRY_USER=sa
REGISTRY_PASSWORD=change-me
REGISTRY_DATABASE=ExportDeskLink
REGISTRY_ENCRYPT=true

# Platform owner sign-in (opens the Clients page). Password may be plain text or a bcrypt hash.
PLATFORM_ADMIN_EMAIL=owner@yourcompany.com
PLATFORM_ADMIN_PASSWORD=change-me

# =====================================================================
#  SINGLE-CLIENT MODE (one company, e.g. app installed on the client's own PC)
#  Leave REGISTRY_SERVER empty and either use the in-app wizard or set DB_* here.
# =====================================================================
# DB_SERVER=WIN-PC\SQLEXPRESS
# DB_PORT=
# DB_AUTH=sql
# DB_DOMAIN=
# DB_USER=sa
# DB_PASSWORD=secret
# DB_DATABASE=ExportDesk
# DB_ENCRYPT=true
